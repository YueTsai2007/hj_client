<!DOCTYPE html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>悍匠 · 战场终端设计预览</title><style>
:root{color-scheme:dark;--bg:#05090d;--p:#09131b;--edge:#254150;--red:#ff4f5d;--blue:#3baeff;--gold:#f8ac37;--txt:#e6eef0;--muted:#9aacb4}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -20%,#17323a,#05090d 55%);color:var(--txt);font-family:'Microsoft YaHei',system-ui,sans-serif}button{font:inherit}button:focus-visible{outline:2px solid white;outline-offset:3px}.app{max-width:1920px;margin:auto;padding:12px 18px 18px}.top{display:grid;grid-template-columns:minmax(190px,1fr) minmax(540px,2.8fr) minmax(190px,1fr);align-items:center;gap:12px}.brand{display:flex;align-items:center;gap:10px}.brand img{width:42px;height:42px;object-fit:cover;mix-blend-mode:screen}.brand b{display:block;letter-spacing:3px;font-size:18px}.brand small{display:block;letter-spacing:1.2px;font-size:9px;color:#9dabb0}.center{display:grid;grid-template-columns:1fr 154px 1fr;align-items:center;gap:9px}.team{text-align:center}.team b{font-size:13px}.team small{display:block;font:10px ui-monospace,monospace;color:#97aeb9;margin-top:3px}.meter{height:19px;margin-top:6px;background:#9d333b;clip-path:polygon(0 0,100% 0,96% 100%,4% 100%);position:relative}.blue .meter{background:#16527c}.meter:before{content:'';display:block;width:78%;height:100%;background:linear-gradient(90deg,#aa2638,#ff5962);box-shadow:0 0 20px #ff3b58}.blue .meter:before{background:linear-gradient(90deg,#198bd1,#61dcff);width:72%}.meter strong{position:absolute;inset:1px 0;text-align:center;font:700 15px ui-monospace,monospace;color:white;text-shadow:0 1px 3px #000}.time{text-align:center;background:linear-gradient(180deg,#182c32,#0b141b);border:1px solid #486474;clip-path:polygon(4% 0,96% 0,84% 100%,16% 100%);padding:5px}.time small{font-size:10px;color:#c0d0d2}.time strong{display:block;font:700 29px ui-monospace,monospace;letter-spacing:2px}.status{justify-self:end;text-align:right;font-size:10px;line-height:1.9;color:#b9c5c9}.status b{color:#f8bc57}.bar{display:flex;align-items:center;gap:11px;margin:15px 0 10px;padding:9px 12px;background:#0a151d;border:1px solid #283f4b}.bar h1{font-size:13px;letter-spacing:2px;margin:0}.bar .en{font:10px ui-monospace,monospace;color:#91a5ad;letter-spacing:1px}.bar .spacer{flex:1}.pill{font-size:10px;color:#ffd183;border:1px solid #805d2a;padding:4px 8px}.main{display:grid;grid-template-columns:minmax(215px,1fr) minmax(400px,2.2fr) minmax(215px,1fr);gap:10px;align-items:stretch}.panel{border:1px solid #344d59;background:linear-gradient(145deg,#101b22,#070e14 55%);min-width:0;position:relative}.panel:after{content:'';position:absolute;right:-1px;bottom:-1px;border-left:9px solid transparent;border-bottom:9px solid #0a1117;pointer-events:none}.head{height:36px;display:flex;align-items:center;gap:8px;padding:0 11px;background:#17232c;border-bottom:1px solid #344d59}.head h2{margin:0;font-size:12px;letter-spacing:.04em}.head small{margin-left:auto;font:9px ui-monospace,monospace;color:#a2b5be}.ally{border-top:2px solid var(--red)}.enemy{border-top:2px solid var(--blue)}.ally .head small{color:#ff939b}.enemy .head small{color:#7ad4ff}.units{padding:7px;display:grid;gap:6px}.robot{background:linear-gradient(115deg,#16232b,#0b151b 70%);border:1px solid #354852;border-left:3px solid var(--red);padding:7px 8px;position:relative}.enemy .robot{border-left-color:var(--blue)}.rline{display:flex;align-items:center;gap:8px}.num{font:700 21px ui-monospace,monospace;min-width:22px;text-align:center;color:#e6ecec}.role{font-size:12px;font-weight:700}.role small{display:block;font:9px ui-monospace,monospace;color:#91a5ad;margin-top:3px}.percent{margin-left:auto;font:700 12px ui-monospace,monospace}.progress{height:4px;background:#263d47;margin:7px 0 4px}.progress i{display:block;height:100%;background:var(--red);box-shadow:0 0 8px #fb4b5466}.enemy .progress i{background:var(--blue);box-shadow:0 0 8px #3baeff66}.info{display:flex;justify-content:space-between;font:10px ui-monospace,monospace;color:#b5c3c7}.info .online{color:#78e7b0}.info .offline{color:#acb8bb}.off{opacity:.62}.maphead button{margin-left:auto;background:#152730;border:1px solid #58717c;color:#dce9eb;padding:5px 9px;cursor:pointer;font-size:10px}.map{position:relative;aspect-ratio:1.52;background:#0c1b23;overflow:hidden}.map svg{display:block;width:100%;height:100%;position:absolute;inset:0}.mapstage{position:absolute;inset:0;transition:transform .25s}.mapstage.flip{transform:rotate(180deg)}.marker{position:absolute;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;color:white;font:700 13px ui-monospace,monospace;background:#ff4f5d;box-shadow:0 0 0 3px #ff4f5d3d,0 2px 9px #000}.marker.blue{background:#319dff;box-shadow:0 0 0 3px #319dff44,0 2px 9px #000}.marker:after{content:'';position:absolute;top:29px;width:28px;height:4px;background:#8cec9c;border:1px solid #182a2e}.mapstage.flip .marker{transform:rotate(180deg)}.mapfoot{position:absolute;bottom:8px;left:9px;right:9px;display:flex;justify-content:space-between;align-items:center;color:#c4d6d8;font-size:10px;text-shadow:0 1px 3px #000}.mapfoot span{background:#061018df;padding:4px 7px}.lower{display:grid;grid-template-columns:1fr 2.2fr 1fr;gap:10px;margin-top:10px}.lower .panel{min-height:170px}.events{padding:8px 12px}.event{display:flex;gap:11px;font-size:11px;color:#d3e1e1;padding:5px 0;border-bottom:1px solid #ffffff0c}.event time{color:#9db0b9;font:10px ui-monospace,monospace}.event em{color:#77dcaf;font-style:normal}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;padding:9px}.metric{min-height:100px;padding:12px 10px;border:1px solid #314852;background:#0a1821;text-align:center}.metric small{font-size:10px;color:#becbd0}.metric strong{display:block;font:700 25px ui-monospace,monospace;margin:13px 0 4px;color:#50beff}.metric:nth-child(2) strong,.metric:nth-child(3) strong{color:#ffbf50}.metric:nth-child(4) strong{color:#ff6973}.metric span{font-size:10px;color:#b5c4c9}.analysis{font-size:10px;color:#aebec4;margin:0 10px 10px}.cam{height:130px;margin:8px;display:grid;place-items:center;background:linear-gradient(135deg,#132a30,#070c10);border:1px solid #354751;text-align:center;color:#b5c7c8}.cam strong{display:block;color:#d9e4e3;font-size:12px}.cam small{font-size:10px}.footer{display:flex;justify-content:space-between;margin-top:11px;color:#9aadb4;font:10px ui-monospace,monospace}.footer b{color:#f5bd6a}@media(max-width:1000px){.top{grid-template-columns:1fr;gap:10px}.status{justify-self:start;text-align:left}.main{grid-template-columns:1fr 2fr}.enemy{grid-column:1/-1}.enemy .units{grid-template-columns:repeat(3,1fr)}.lower{grid-template-columns:1fr 1fr}.lower .panel:nth-child(2){grid-column:span 1}.metrics{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.app{padding:10px}.center{grid-template-columns:1fr 90px 1fr}.time strong{font-size:22px}.main,.lower{grid-template-columns:1fr}.enemy{grid-column:auto}.enemy .units{grid-template-columns:1fr}.map{min-height:260px}.metrics{grid-template-columns:repeat(2,1fr)}.bar .en{display:none}.footer{gap:10px;flex-wrap:wrap}}@media(prefers-reduced-motion:reduce){.mapstage{transition:none}}
+</style></head><body><div class="app"><header class="top"><div class="brand"><img src="logo.jpg" alt="悍匠战队标志"><div><b>悍匠</b><small>SHENZHEN TECHNOLOGY UNIVERSITY</small></div></div><div class="center"><div class="team red"><b>深圳技术大学 悍匠</b><small>RED ALLIANCE · BASE HP</small><div class="meter"><strong>3,200</strong></div></div><div class="time"><small>第 01 局 / 对战中</small><strong>03:42</strong></div><div class="team blue"><b>蓝方联盟</b><small>BLUE ALLIANCE · BASE HP</small><div class="meter"><strong>2,840</strong></div></div></div><div class="status"><b>●</b> 界面预览 / 未接入真实比赛<br>赛事信息 · 视频 · 战术地图</div></header><main><div class="bar"><h1>战场态势</h1><span class="en">TACTICAL OVERVIEW / HANJIANG</span><span class="spacer"></span><span class="pill">演示数据 · DESIGN V3</span></div><div class="main"><section class="panel ally"><div class="head"><h2>我方机器人　<span style="color:#a6b9bd">5 / 6</span></h2><small>ALLY UNIT</small></div><div class="units" id="ally"></div></section><section class="panel"><div class="head maphead"><h2>战场地图</h2><small style="margin-left:0">TACTICAL MAP</small><button id="flip" type="button" aria-pressed="false">切换视角</button></div><div class="map"><div class="mapstage" id="stage"><svg viewBox="0 0 900 590" preserveAspectRatio="none" aria-hidden="true"><defs><pattern id="grid" width="36" height="36" patternUnits="userSpaceOnUse"><path d="M36 0H0V36" fill="none" stroke="#48616a" stroke-opacity=".22"/></pattern><linearGradient id="floor"><stop stop-color="#122a31"/><stop offset=".5" stop-color="#18272e"/><stop offset="1" stop-color="#112631"/></linearGradient></defs><rect width="900" height="590" fill="url(#floor)"/><rect width="900" height="590" fill="url(#grid)"/><path d="M24 25H876V565H24Z" fill="none" stroke="#667b80" stroke-width="5"/><path d="M450 25V565" stroke="#728c8a" stroke-opacity=".6" stroke-dasharray="10 8"/><path d="M24 105H225L295 32H376L300 138H190L150 192H24 M876 485H675L605 558H524L600 452H710L750 398H876" fill="#25383d" stroke="#506967" stroke-width="4"/><path d="M25 385H160L240 490H360L325 552H120L25 475 M875 205H740L660 100H540L575 38H780L875 115" fill="#26363a" stroke="#586a69" stroke-width="4"/><path d="M295 295L450 183 605 295 450 407Z" fill="#263b40" stroke="#81948d" stroke-width="3"/><path d="M364 295L450 232 536 295 450 358Z" fill="#101f28" stroke="#5d7774" stroke-width="3"/><rect x="238" y="235" width="28" height="120" fill="#334740" stroke="#7c8b70"/><rect x="634" y="235" width="28" height="120" fill="#334740" stroke="#7c8b70"/><path d="M40 244H108L145 295 108 346H40Z" fill="#9b3641" stroke="#ff6a70" stroke-width="3"/><path d="M860 244H792L755 295 792 346H860Z" fill="#1b709b" stroke="#64cfff" stroke-width="3"/><circle cx="82" cy="295" r="28" fill="#d85c60" stroke="#ffc2bd" stroke-width="3"/><circle cx="818" cy="295" r="28" fill="#38a6d8" stroke="#c1efff" stroke-width="3"/><g fill="#344a45" stroke="#7c9378" stroke-width="2"><rect x="180" y="95" width="70" height="35"/><rect x="650" y="460" width="70" height="35"/><rect x="315" y="400" width="53" height="38"/><rect x="532" y="152" width="53" height="38"/><rect x="365" y="98" width="45" height="25"/><rect x="490" y="467" width="45" height="25"/></g><text x="65" y="300" fill="white" font-size="13">基地</text><text x="803" y="300" fill="white" font-size="13">基地</text></svg><div class="marker" style="left:17%;top:28%">1</div><div class="marker" style="left:29%;top:63%">3</div><div class="marker" style="left:38%;top:30%">4</div><div class="marker" style="left:13%;top:74%">7</div><div class="marker blue" style="left:78%;top:29%">1</div><div class="marker blue" style="left:68%;top:54%">3</div><div class="marker blue" style="left:58%;top:67%">4</div><div class="marker blue" style="left:72%;top:76%">7</div></div><div class="mapfoot"><span>示意地图 · 非实际赛场</span><span>红方 ●　蓝方 ●</span></div></div></section><section class="panel enemy"><div class="head"><h2>敌方机器人　<span style="color:#a6b9bd">5 / 6</span></h2><small>ENEMY UNIT</small></div><div class="units" id="enemy"></div></section></div><div class="lower"><section class="panel"><div class="head"><h2>战场事件</h2><small style="color:#ffc46a">LATEST</small></div><div class="events"><div class="event"><time>03:58</time><em>比赛进入对战阶段</em></div><div class="event"><time>03:51</time><span>我方机器人已上线</span></div><div class="event"><time>03:46</time><span>基地状态已更新</span></div><div class="event"><time>03:42</time><em>战场数据更新</em></div></div></section><section class="panel"><div class="head"><h2>战场数据</h2><small>FIELD OVERVIEW</small></div><div class="metrics"><div class="metric"><small>红方比分</small><strong>128</strong><span>示例数据</span></div><div class="metric"><small>蓝方比分</small><strong>116</strong><span>示例数据</span></div><div class="metric"><small>我方在线</small><strong>5 / 6</strong><span>机器人</span></div><div class="metric"><small>基地血量差</small><strong>+360</strong><span>红方领先</span></div></div><p class="analysis">当前数据仅用于界面展示，不代表比赛信息或协议字段。</p></section><section class="panel"><div class="head"><h2>图传画面</h2><small>VIDEO / WAIT</small></div><div class="cam"><div><strong>等待图传接入</strong><small>VIDEO FEED PLACEHOLDER</small></div></div></section></div><footer class="footer"><span><b>HANJIANG</b>　/　深圳技术大学悍匠战队</span><span>CONCEPT UI · 本页面未连接比赛系统</span></footer></main></div><script>const robots=[['1','英雄','HERO',82,'246 / 300'],['2','工程','ENGINEER',100,'250 / 250'],['3','步兵','INFANTRY',87,'130 / 150'],['4','步兵','INFANTRY',100,'150 / 150'],['6','空中','AERIAL',0,'0 / 150'],['7','哨兵','SENTRY',57,'230 / 400']];function render(id,enemy){document.getElementById(id).innerHTML=robots.map((r,i)=>{let p=r[3];return `<div class="robot ${p?'':'off'}"><div class="rline"><span class="num">${r[0]}</span><span class="role">${r[1]}<small>${r[2]}</small></span><span class="percent">${p?p+'%':'--'}</span></div><div class="progress"><i style="width:${p}%"></i></div><div class="info"><span>${r[4]} HP</span><span class="${p?'online':'offline'}">${p?'在线':'离线'}</span></div></div>`}).join('')}render('ally',false);render('enemy',true);const btn=document.getElementById('flip');btn.onclick=()=>{let on=document.getElementById('stage').classList.toggle('flip');btn.setAttribute('aria-pressed',String(on));btn.textContent=on?'恢复视角':'切换视角'};</script></body></html>

